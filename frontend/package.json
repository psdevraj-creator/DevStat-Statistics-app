{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:tsc": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:start": "electron .",
    "desktop:build": "electron-builder",
    "desktop:build:win": "electron-builder --win",
    "desktop:build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "ag-grid-community": "^35.3.1",
    "ag-grid-react": "^35.3.1",
    "antd": "^5.29.3",
    "axios": "^1.17.0",
    "plotly.js": "^3.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-plotly.js": "^3.0.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.devstat.app",
    "productName": "DevStat",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../backend/dist/DevStatEngine", "to": "engine" }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["msi", "nsis"]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.medical"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
